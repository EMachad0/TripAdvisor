{
  "name": "asia-trip-ranker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asia Trip Ranker: curator platform (schema, renderer, CLI) and game",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "atr": "./atr"
  },
  "scripts": {
    "atr": "node atr",
    "test": "node --test \"platform/test/**/*.test.js\" \"game/test/**/*.test.js\"",
