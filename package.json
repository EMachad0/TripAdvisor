    "game": "node game/server.js"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@napi-rs/canvas": "1.0.13",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  }
}
