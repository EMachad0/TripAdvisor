{
  "name": "asia-trip-ranker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asia Trip Ranker: the trip site (apps/web, Convex) and the curator platform (schema, renderer, CLI)",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "atr": "./atr"
  },
  "scripts": {
    "atr": "node atr",
    "test": "\"$npm_execpath\" -r --if-present test",
    "schema:export": "node platform/cli/atr.js schema --export",
    "lint": "\"$npm_execpath\" --filter @atr/web exec svelte-kit sync && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "\"$npm_execpath\" -r --if-present typecheck",
    "e2e": "\"$npm_execpath\" --filter @atr/web e2e",
    "verify": "\"$npm_execpath\" format:check && \"$npm_execpath\" lint && \"$npm_execpath\" typecheck && \"$npm_execpath\" test && \"$npm_execpath\" e2e"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@napi-rs/canvas": "1.0.13",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  }
}
