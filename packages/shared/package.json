{
	"name": "@atr/shared",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Strict TS ports of game/lib and platform pure logic, plus the v1 codec. Imported as TS source (no build step).",
	"exports": {
		".": "./src/index.ts",
		"./elo": "./src/elo.ts",
		"./pairing": "./src/pairing.ts",
		"./board": "./src/board.ts",
		"./feedback": "./src/feedback.ts",
		"./trip": "./src/trip.ts",
		"./routemap": "./src/routemap.ts",
		"./route": "./src/route.ts",
		"./content": "./src/content.ts",
		"./routemodel": "./src/routemodel.ts",
		"./v1": "./src/v1.ts",
		"./schema/check": "./src/schema/check.ts",
		"./schema/dsl": "./src/schema/dsl.ts",
		"./schema/enums": "./src/schema/enums.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
		"test": "vitest run",
		"lint": "eslint --max-warnings 0 ."
	},
	"devDependencies": {
		"@atr/platform": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
