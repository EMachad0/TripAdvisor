				"apps/web/e2e/bag.spec.ts",
				"docs/migration/parity/money-prep.md"
			]
		},
		"H": {
			"name": "Content pages, embed glue, media, maps",
			"branches": [
				"mig/t9-h",
				"mig/t9-h-*",
				"mig/t9-*/h",
				"mig/t9-*/h-*"
			],
			"owns": [
				"apps/web/src/routes/place/**",
				"apps/web/src/routes/area/**",
				"apps/web/src/routes/media/**",
				"apps/web/src/routes/area-media/**",
				"apps/web/src/routes/map/**",
				"apps/web/src/routes/area-map/**",
				"apps/web/embed/**",
				"apps/web/src/routes/embed/**",
				"apps/web/src/routes/assets/**",
				"apps/web/src/lib/server/maps.ts",
