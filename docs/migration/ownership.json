{
	"$comment": [
		"Who may edit what on mig/* branches (plan section 9 and section 17 task 9). Checked by scripts/check-ownership.ts.",
		"A slice branch may touch only its `owns` paths plus docs/migration/parity/<slice>.md. `shared` paths are edited only on integrator branches.",
		"mig/next itself (the cutover PR) and branches outside mig/* (answer cards, curators) are not checked.",
		"Globs: * matches within one path segment, ** across segments."
	],
	"shared": [
		"apps/web/package.json",
		"pnpm-lock.yaml",
		"pnpm-workspace.yaml",
		"tooling/package.json",
		"apps/web/src/convex/schema.ts",
		"apps/web/src/convex/tables/**",
		"apps/web/src/convex/_generated/**"
	],
	"integratorBranches": [
		"mig/integrator",
		"mig/integrator-*",
		"mig/integrator/*"
	],
	"unchecked": [
		"mig/next"
	],
	"slices": {
		"A": {
			"name": "Today",
			"branches": [
				"mig/t9-a",
				"mig/t9-a-*",
				"mig/t9-*/a",
				"mig/t9-*/a-*"
			],
			"owns": [
				"apps/web/src/routes/(app)/+page.svelte",
				"apps/web/src/routes/(app)/today/**",
				"apps/web/src/lib/features/today/**",
				"apps/web/e2e/today.spec.ts",
				"docs/migration/parity/today.md"
			]
		},
		"B": {
			"name": "Itinerary, Calendar, trip forms",
			"branches": [
				"mig/t9-b",
				"mig/t9-b-*",
				"mig/t9-*/b",
				"mig/t9-*/b-*"
			],
			"owns": [
				"apps/web/src/routes/(app)/trip/+page.svelte",
				"apps/web/src/routes/(app)/trip/itinerary/**",
				"apps/web/src/routes/(app)/trip/calendar/**",
				"apps/web/src/lib/features/trip/**",
				"apps/web/e2e/itinerary.spec.ts",
				"apps/web/e2e/calendar.spec.ts",
				"docs/migration/parity/trip.md"
			]
		},
		"C": {
			"name": "Route map",
			"branches": [
				"mig/t9-c",
				"mig/t9-c-*",
				"mig/t9-*/c",
