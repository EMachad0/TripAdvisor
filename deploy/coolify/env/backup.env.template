# /root/.config/atr-backup/backup.env on the VPS (mode 600, root only): config of deploy/backup/backup.sh.
# NAMES ONLY here; the real file holds no secret except paths to the secret files below.
#
# Where objects go: an rclone remote path (<remote>:<bucket>/atr, bucket not chosen yet: placeholder) or an
# absolute local directory (works today, e.g. /var/backups/atr).
BACKUP_DEST=
# Host path of the old trip-site /data volume (holds feedback/ and trip/), e.g.
# /var/lib/docker/volumes/<coolify volume>/_data
OLD_DATA_DIR=
# age public keys (age1…). Owner: every object. CI: old/ and convex/ only (never convex-env/).
AGE_OWNER_RECIPIENT=
AGE_CI_RECIPIENT=
# Default /root/.config/atr-backup/convex.env (mode 600): CONVEX_SELF_HOSTED_URL, CONVEX_SELF_HOSTED_ADMIN_KEY.
CONVEX_ENV_FILE=
# Docker network the Convex CLI container joins (default coolify).
CONVEX_DOCKER_NETWORK=
# Default /root/.config/atr-backup/rclone.conf (mode 600, the bucket's write-only key).
RCLONE_CONFIG=
# Disk reported in status/ objects (default /).
STATUS_DISK_PATH=
# Default node:24-slim.
CONVEX_NODE_IMAGE=
