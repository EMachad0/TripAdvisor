# Coolify env of trip-web (apps/web/Dockerfile). NAMES ONLY. Read at runtime: a change needs a redeploy, not a
# rebuild. PORT, HOST, ATR_ROOT and ATR_CACHE_DIR have image defaults and are listed for completeness.
#
# 3000 (image default).
PORT=
# 0.0.0.0 (image default).
HOST=
# https://new.<site> before cutover, https://<site> after (cutover step 8c). Spike S13.
ORIGIN=
# X-Forwarded-For behind Coolify's Traefik; XFF_DEPTH from spike S21 (1 with one proxy hop).
ADDRESS_HEADER=
XFF_DEPTH=
# https://api.<site>
PUBLIC_CONVEX_URL=
# https://cvx.<site>
PUBLIC_CONVEX_SITE_URL=
# Same value as ORIGIN; equals Convex SITE_URL.
PUBLIC_SITE_URL=
# /app/content (image default; places/ areas/ answers/ config/ are baked in).
ATR_ROOT=
# /data/cache (image default; mount the web-cache volume there).
ATR_CACHE_DIR=
# Raw content token; its sha256 is CONTENT_TOKEN_SHA256 in the Convex deployment env.
CONTENT_TOKEN=
#
# Build argument (Coolify passes SOURCE_COMMIT; set GIT_SHA to it so /healthz reports the commit):
GIT_SHA=
