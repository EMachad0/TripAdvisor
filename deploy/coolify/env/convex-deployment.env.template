# Convex DEPLOYMENT env (inside Convex, not Coolify). NAMES ONLY. Set each with the value on stdin:
#   printf %s "$VALUE" | scripts/convex-prod.sh env set NAME
# Check with `scripts/convex-prod.sh env list` (names only). The nightly backup keeps the values in convex-env/
# objects, encrypted to the owner alone.
#
# https://new.<site> before cutover, https://<site> after (cutover step 8a).
SITE_URL=
# Comma list of exact origins, no wildcards: https://new.<site>,https://<site>
TRUSTED_ORIGINS=
# 32 random bytes, base64 (openssl rand -base64 32). Changing it invalidates the stored JWT signing key.
BETTER_AUTH_SECRET=
# sha256 (hex) of trip-web's CONTENT_TOKEN; the raw token lives only in Coolify's trip-web env.
CONTENT_TOKEN_SHA256=
# sha256 (hex) of EXPORT_TOKEN; the raw token lives only in the laptop keychain.
EXPORT_TOKEN_SHA256=
#
# Temporary, minutes only (cutover step 6), removed right after admin:seedAccounts:
#   SEED_OWNER_USERNAME SEED_OWNER_PASSWORD SEED_GUEST_USERNAME SEED_GUEST_PASSWORD
# Never on production: ATR_CI_DEPLOYMENT, JWT_EXPIRATION_SECONDS, AUTH_SIGNIN_LIMIT_PER_MINUTE, E2E_OWNER_PASSWORD.
