# /root/.config/atr-convex-deploy/convex-deploy.env on the VPS (mode 600, root only): config of
# deploy/convex-deploy/convex-deploy.sh. NAMES ONLY here; the real file holds no secret, only the path to one.
#
# Coolify uuid of the trip-web application (its containers are named <uuid>-<n>; Coolify → trip-web → the uuid in
# the URL).
APP_UUID=
# Default /root/.config/atr-backup/convex.env (mode 600): CONVEX_SELF_HOSTED_URL, CONVEX_SELF_HOSTED_ADMIN_KEY. The
# same key file the backup job reads.
CONVEX_ENV_FILE=
# Docker network the deploy container joins (default coolify).
CONVEX_DOCKER_NETWORK=
# docker --memory of the deploy container (default 768m).
DEPLOY_MEMORY=
