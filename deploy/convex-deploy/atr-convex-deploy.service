# Deploys the Convex functions of the live trip-web image: deploy/convex-deploy/convex-deploy.sh, installed as
# /usr/local/lib/atr-convex-deploy/convex-deploy.sh, config in /root/.config/atr-convex-deploy/ (mode 600), state in
# /var/lib/atr-convex-deploy/. Started every minute by atr-convex-deploy.timer; `systemctl start
# atr-convex-deploy.service` runs one tick now (a no-op when the live commit is already deployed).
[Unit]
Description=Asia Trip Ranker: deploy the Convex functions of the live trip-web image
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=ATR_CONVEX_DEPLOY_CONFIG=/root/.config/atr-convex-deploy
Environment=ATR_CONVEX_DEPLOY_STATE=/var/lib/atr-convex-deploy
ExecStart=/usr/local/lib/atr-convex-deploy/convex-deploy.sh
StateDirectory=atr-convex-deploy
StateDirectoryMode=0700
UMask=0077
PrivateTmp=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# This unit only runs the docker client; the deploy container itself is capped by DEPLOY_MEMORY (docker --memory).
MemoryMax=256M
TimeoutStartSec=15min
