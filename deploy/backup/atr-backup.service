# Nightly backup of the trip site (plan section 13): deploy/backup/backup.sh, installed as
# /usr/local/lib/atr-backup/backup.sh, config in /root/.config/atr-backup/ (mode 600). Started by atr-backup.timer;
# `systemctl start atr-backup.service` runs it now (the same path as `backup.sh --now`).
[Unit]
Description=Asia Trip Ranker backup (Convex, plus the old /data while OLD_DATA_DIR is set) to the off-VPS store
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=ATR_BACKUP_CONFIG=/root/.config/atr-backup
ExecStart=/usr/local/lib/atr-backup/backup.sh
UMask=0077
PrivateTmp=true
# The Convex leg bind-mounts its staging dir into a docker container, and the docker daemon cannot see this unit's
# private /tmp. Stage under /run/atr-backup instead (mode 700, removed when the job ends).
RuntimeDirectory=atr-backup
RuntimeDirectoryMode=0700
Environment=TMPDIR=/run/atr-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# The job talks to docker (and reads the old volume while OLD_DATA_DIR is set); it never needs more than this.
MemoryMax=512M
TimeoutStartSec=30min
