# Nightly backup of the trip site (plan section 13): deploy/backup/backup.sh, installed as
# /usr/local/lib/atr-backup/backup.sh, config in /root/.config/atr-backup/ (mode 600). Started by atr-backup.timer;
# `systemctl start atr-backup.service` runs it now (the same path as `backup.sh --now`).
[Unit]
Description=Asia Trip Ranker backup (old /data + Convex) to the off-VPS store
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=ATR_BACKUP_CONFIG=/root/.config/atr-backup
ExecStart=/usr/local/lib/atr-backup/backup.sh
UMask=0077
PrivateTmp=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# The job reads the old volume and talks to docker; it never needs more than this.
MemoryMax=512M
TimeoutStartSec=30min
